# Đường dẫn file SQLite
LANTERN_DB=lantern.db
# Số host tối đa mỗi lần quét
LANTERN_MAX_HOSTS=50
# ---- Tra CVE theo phiên bản dịch vụ (cần nmap) ----
# 1 = bật (mặc định), 0 = tắt. Chỉ gửi tên + phiên bản phần mềm lên NVD, không gửi IP/tên miền.
LANTERN_CVE_LOOKUP=1
# API key miễn phí tại https://nvd.nist.gov/developers/request-an-api-key (có key tra nhanh gấp ~10 lần)
LANTERN_NVD_API_KEY=
# Chỉ báo CVE có điểm CVSS từ ngưỡng này trở lên
LANTERN_CVE_MIN_SCORE=7.0
# Số lần tra NVD tối đa mỗi lần quét
LANTERN_CVE_MAX_LOOKUPS=15

# Đặt 1 khi chạy sau HTTPS (Caddy/Nginx). Để 0 khi chạy local qua http.
LANTERN_SECURE_COOKIE=0

# ---- Gửi email OTP (SMTP) ----
# Để trống LANTERN_SMTP_HOST = chế độ phát triển: không gửi email thật, mã OTP in ra terminal chạy server.
# Ví dụ Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App password), KHÔNG dùng mật khẩu Gmail thường.
LANTERN_SMTP_HOST=
LANTERN_SMTP_PORT=587
LANTERN_SMTP_USER=
LANTERN_SMTP_PASSWORD=
# Địa chỉ người gửi (mặc định = LANTERN_SMTP_USER)
LANTERN_SMTP_FROM=
# starttls (cổng 587) | ssl (cổng 465) | none
LANTERN_SMTP_SECURITY=starttls

# ---- Tài khoản admin (tùy chọn) ----
# Điền đủ USERNAME + PASSWORD thì khi khởi động server sẽ tạo tài khoản admin này (nếu chưa có) hoặc nâng quyền admin
# nếu username đã tồn tại (không đổi mật khẩu). Sau lần chạy đầu nên XÓA dòng PASSWORD khỏi .env.
# LANTERN_ADMIN_USERNAME=admin
# LANTERN_ADMIN_PASSWORD=
# LANTERN_ADMIN_EMAIL=admin@example.com
# LANTERN_ADMIN_NAME=Administrator

# ---- Quét ứng dụng web qua OWASP ZAP (tùy chọn, cần chạy ZAP daemon) ----
# LANTERN_WEBVULN=1
# LANTERN_ZAP_API=http://127.0.0.1:8090
# LANTERN_ZAP_ACTIVE_SCAN=0
# LANTERN_ZAP_MAX_URLS=20
# LANTERN_ZAP_MIN_RISK=Low
